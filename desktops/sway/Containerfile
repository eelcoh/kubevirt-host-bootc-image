    && cp /etc/sway/themes/matcha-green/sway.conf /etc/sway/config.d/20-theme.conf \
    && cp /etc/sway/themes/matcha-green/waybar-style.css /etc/xdg/waybar/style.css \
    && cp /etc/sway/themes/matcha-green/alacritty.toml /etc/alacritty/alacritty.toml

# 4. Wire up login. Unlike the niri/DMS flavor, no manual system user needs
# to be created here: Fedora's `greetd` package already ships a sysusers.d
# entry that creates a `greetd` system user (home /var/lib/greetd) — verified
# directly from the RPM — so tuigreet (the greeter front-end) just runs as
# that existing account.
COPY <<-'EOF' /etc/greetd/config.toml
[terminal]
vt = 1

[default_session]
command = "tuigreet --cmd sway"
user = "greetd"
EOF

RUN systemctl enable greetd.service

# 5. Boot straight to the greeter instead of `base`'s console default —
# without this the host stays on `multi-user.target` and greetd never runs,
# leaving the user stuck at a bare tty (see desktops/niri/Containerfile for
# the fuller rationale, which applies identically here).
RUN systemctl set-default graphical.target
