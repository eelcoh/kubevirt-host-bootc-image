#clock, #battery, #cpu, #memory, #temperature, #backlight, #network,
#pulseaudio, #tray, #idle_inhibitor, #scratchpad, #power-profiles-daemon,
#language {
    padding: 0 10px;
    color: #D8DEE9;
}

#clock { background-color: #434C5E; }
#cpu { background-color: #5E81AC; color: #ECEFF4; }
#memory { background-color: #B48EAD; color: #2E3440; }
#temperature { background-color: #D08770; color: #2E3440; }
#temperature.critical { background-color: #BF616A; color: #ECEFF4; }
#backlight { background-color: #81A1C1; color: #2E3440; }
#network { background-color: #5E81AC; color: #ECEFF4; }
#network.disconnected { background-color: #BF616A; color: #ECEFF4; }
#pulseaudio { background-color: #EBCB8B; color: #2E3440; }
#pulseaudio.muted { background-color: #4C566A; color: #D8DEE9; }
#battery { background-color: #A3BE8C; color: #2E3440; }
#battery.charging, #battery.plugged { background-color: #8FBCBB; color: #2E3440; }
#battery.critical:not(.charging) { background-color: #BF616A; color: #ECEFF4; }
#tray { background-color: #434C5E; }
#idle_inhibitor { background-color: #434C5E; }
#idle_inhibitor.activated { background-color: #88C0D0; color: #2E3440; }
EOF

