ARG BASE_IMAGE=ghcr.io/eelcoh/kubevirt-host-bootc-image/base:latest
FROM ${BASE_IMAGE}

# 1. Desktop: Sway, an i3-compatible tiling Wayland compositor built on
# wlroots. All plain Fedora 44 packages, no COPR (verified: `dnf search`/
# `dnf group info swaywm-extended` against this base).
#
# - sway-config-fedora: Fedora's own stock default keybinds/config for Sway
#   (part of the Fedora Sway Spin's own package set).
# - waybar: Sway has no built-in status bar (unlike niri+DMS), so one is
#   installed explicitly.
# - swaybg / swaylock / swayidle: wallpaper, screen lock, and idle daemon —
#   the standard companion trio for a Sway session.
# - alacritty: same terminal used by the other desktop flavors, for
#   consistency.
# - xdg-desktop-portal-wlr: screen capture/sharing portal backend for
#   wlroots-based compositors — Sway is genuinely wlroots-based (unlike
#   niri, which uses its own portal implementation), so this is the correct
#   backend here.
# - xdg-desktop-portal-gtk + gnome-keyring + polkit-kde: file chooser,
#   secrets, and a standalone polkit authentication agent — same rationale
#   as the niri flavor.
# - greetd + tuigreet: a generic greeter daemon with a console/TUI login
#   front-end.
# - fedora-workstation-backgrounds: Fedora's own official wallpaper set
#   (CC-BY-4.0), used for the default swaybg wallpaper wired up in step 2 —
#   plain Fedora package, no custom art asset needed.
RUN dnf -y install \
    sway \
    sway-config-fedora \
    waybar \
    swaybg \
    swaylock \
    swayidle \
    alacritty \
    xdg-desktop-portal \
    xdg-desktop-portal-wlr \
    xdg-desktop-portal-gtk \
    gnome-keyring \
    polkit-kde \
    greetd \
    tuigreet \
    pipewire \
    pipewire-pulseaudio \
    pipewire-alsa \
    wireplumber \
    google-noto-sans-fonts \
    google-noto-emoji-fonts \
    fedora-workstation-backgrounds \
    && dnf clean all

# 2. Wallpaper. sway-config-fedora's /etc/sway/config includes every file
# under /etc/sway/config.d/*.conf (see its own layered-include comment
# there), so a wallpaper is wired up the same way as its own bindings/rules
# snippets rather than by editing /etc/sway/config directly. swaybg (already
# installed above) reads this via gdk-pixbuf2/glycin, which decodes .webp
# fine (verified: glycin-image-rs, pulled in as swaybg's own dependency,
# lists image/webp in its loader conf).
COPY <<-'EOF' /etc/sway/config.d/40-wallpaper.conf
output * bg /usr/share/backgrounds/fedora-workstation/mermaid_dark.webp fill
EOF

# 3. Themes. Four color themes for sway + waybar + alacritty, each as a
# self-contained (sway.conf, waybar-style.css, alacritty.toml) triple under
# /etc/sway/themes/<name>/. Matcha Green is activated as the system default
# (client colors dropped into /etc/sway/config.d/ alongside step 2's
# wallpaper snippet, waybar's default /etc/xdg/waybar/style.css replaced,
# and alacritty's system-wide /etc/alacritty/alacritty.toml written) —
# the other three themes ship as reference copies only; switch to one by
# copying its three files over the active ones and running `swaymsg
# reload` (sway/waybar pick this up live; a new alacritty window picks up
# alacritty.toml automatically since it's read at window-open, not startup).
#
# - Nord: nordtheme.com's own published palette (nord0-nord15); the
#   alacritty color mapping matches its widely-published alacritty port.
# - Catppuccin: the Mocha (dark) variant of catppuccin.com's published
#   palette; the alacritty mapping matches catppuccin/alacritty's own
#   published Mocha theme.
# - Matcha Green: an original vibrant-green-on-dark-gray palette built
#   around #8BC34A, matching the issue's own "vibrant green and dark gray"
#   description (not a literal port of any single upstream project).
# - Chameleon Grove Green: sway/waybar colors are a direct port of
#   cryinkfly/SwayWM-Themes' "Chameleon Grove Green" (openSUSE-palette
#   inspired; matches this theme's own upstream description almost
#   verbatim). That project doesn't ship an Alacritty config, so its
#   alacritty.toml here extends the same green family to a full 16-color
#   ANSI palette instead of porting one 1:1.
RUN mkdir -p /etc/sway/themes/nord /etc/sway/themes/catppuccin \
    /etc/sway/themes/matcha-green /etc/sway/themes/chameleon-grove-green

COPY <<-'EOF' /etc/sway/themes/nord/sway.conf
# Nord — https://www.nordtheme.com/
# client.<class> <border> <background> <text> <indicator> <child_border>
client.focused          #88C0D0 #2E3440 #ECEFF4 #88C0D0 #88C0D0
client.focused_inactive #4C566A #3B4252 #D8DEE9 #4C566A #4C566A
client.unfocused        #3B4252 #2E3440 #D8DEE9 #3B4252 #3B4252
client.urgent            #BF616A #BF616A #ECEFF4 #BF616A #BF616A
client.placeholder      #3B4252 #2E3440 #D8DEE9 #3B4252 #3B4252
client.background       #2E3440
EOF

COPY <<-'EOF' /etc/sway/themes/nord/waybar-style.css
* {
    font-family: 'Noto Sans Mono', 'Font Awesome 6 Free', 'Font Awesome 6 Brands', monospace;
    font-size: 13px;
}

window#waybar {
    background-color: rgba(46, 52, 64, 0.9);
    border-bottom: 3px solid #4C566A;
    color: #D8DEE9;
}

window#waybar.hidden { opacity: 0.2; }

#workspaces button {
    padding: 0 8px;
    background-color: transparent;
    color: #D8DEE9;
    border-bottom: 3px solid transparent;
}

#workspaces button:hover { background-color: #3B4252; }

#workspaces button.focused,
#workspaces button.active {
    color: #2E3440;
    background-color: #88C0D0;
    border-bottom: 3px solid #8FBCBB;
}

