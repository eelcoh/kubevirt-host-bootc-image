ARG BASE_IMAGE=ghcr.io/eelcoh/kubevirt-host-bootc-image/base:latest
FROM ${BASE_IMAGE}

# 1. Desktop: Niri (scrollable-tiling Wayland compositor) + DankMaterialShell
# (DMS, a Quickshell-based shell that replaces the usual pile of bar/
# launcher/lock/notification daemons) — deliberately not GNOME/KDE/etc. All
# of niri, quickshell and DankMaterialShell are plain Fedora 44 packages, no
# COPR required (verified directly: `dnf search`/`dnf info` against this
# base pulls them straight from the `fedora`/`updates` repos).
#
# - xdg-desktop-portal-gtk / -gnome + gnome-keyring + polkit-kde: niri's own
#   upstream guidance (github.com/niri-wm/niri wiki, "Important Software")
#   for portals (file chooser + screencast), secrets, and a polkit
#   authentication agent. polkit-kde despite the name is a ~300KB standalone
#   agent, not KDE/Plasma itself.
# - alacritty: matches the terminal niri's own default-config.kdl binds to
#   Mod+T out of the box, so the default keybind works unmodified.
# - greetd: a generic greeter daemon; wired up to DMS's own bundled greeter
#   in step 3, rather than a GNOME/KDE display manager.
# - --exclude=waybar: niri's own RPM `Recommends: waybar` (also fuzzel,
#   swaylock), which dnf pulls in by default. DMS already replaces waybar's
#   role with its own DankBar — installing both means the DMS-less waybar
#   ends up on top of the desktop (see step 2 for why it would actually run).
#   fuzzel/swaylock are left alone: they're only reachable via niri's default
#   keybinds, not auto-started, so they're harmless clutter rather than a
#   visible bug.
# - swaybg + fedora-workstation-backgrounds: DMS has its own wallpaper
#   module, but it stores the chosen path in per-user session state that
#   starts out empty, so nothing renders until a user picks one by hand.
#   swaybg (spawned in step 2 below) paints Fedora's own official wallpaper
#   art (CC-BY-4.0) as a layer-shell background underneath it instead, so
#   the session isn't blank out of the box; DMS's own wallpaper module still
#   takes over the moment a user sets one.
RUN dnf -y install \
    --exclude=waybar \
    niri \
    DankMaterialShell \
    alacritty \
    xdg-desktop-portal \
    xdg-desktop-portal-gtk \
    xdg-desktop-portal-gnome \
    gnome-keyring \
    polkit-kde \
    greetd \
    pipewire \
    pipewire-pulseaudio \
    pipewire-alsa \
    wireplumber \
    google-noto-sans-fonts \
    google-noto-emoji-fonts \
    swaybg \
    fedora-workstation-backgrounds \
    && dnf clean all

# 2. Generate /etc/niri/config.kdl from niri's own shipped default, with
# just its `spawn-at-startup "waybar"` line stripped.
#
# We never ship a config for the real logged-in user, and niri's config
# search order (XDG_CONFIG_HOME/niri/config.kdl -> ~/.config/niri/config.kdl
# -> /etc/niri/config.kdl -> its own compiled-in default) means it was
# falling all the way through to that compiled-in default — which spawns
# waybar at startup regardless of whether the package is even installed.
# Deriving from niri's own /usr/share/doc/niri/default-config.kdl (rather
# than hand-copying it into this Containerfile) keeps this in sync with
# whatever default Fedora's niri build actually ships, instead of drifting
# from it over time.
RUN mkdir -p /etc/niri \
    && sed -e '/This line starts waybar/d' -e '/^spawn-at-startup "waybar"$/d' \
    /usr/share/doc/niri/default-config.kdl > /etc/niri/config.kdl \
    && printf '\nspawn-at-startup "swaybg" "-i" "/usr/share/backgrounds/fedora-workstation/mermaid_dark.webp" "-m" "fill"\n' \
    >> /etc/niri/config.kdl

# 3. Wire up login and first-user-session autostart, then enable everything
# that should come up automatically.
#
# DankMaterialShell ships its own greetd-native greeter (the "dms-greeter"
# script + matching niri/greetd config templates) under
# /usr/share/quickshell/dms/Modules/Greetd/, but — unlike Arch/openSUSE/
# Debian — Fedora doesn't yet package a separate `dms-greeter` RPM that does
# this wiring automatically. This replicates DMS upstream's own documented
# manual-install steps for that case (see DankMaterialShell's
# Modules/Greetd/README.md "Manual (fallback only)" section) rather than
# inventing a new install path: create the greeter system user, install the
# dms-greeter wrapper, and point greetd's config.toml at it.
#
# Crucially, the greeter's runtime dirs (/var/lib/greeter, /var/cache/
# dms-greeter) are NOT created with a build-time `mkdir` — bootc treats
# content placed under /var in the image like a Docker `VOLUME /var`: it's
# only unpacked from the *initial* image a host is installed from, and is
# never re-synced on later updates/rebases (see bootc's filesystem docs).
# A `mkdir` here would just silently stop taking effect the moment this
# image is rebuilt and the host upgrades to the new build, at which point
# dms-greeter's own `[[ ! -d "$CACHE_DIR" ]]` check starts failing on every
# launch, greetd crash-loops past its StartLimitBurst, and greetd.service
# itself ends up "failed" (exactly the boot failure this was hitting).
# Instead, install DMS's own tmpfiles.d snippet — it already ships one for
# this exact pair of directories — into /usr/lib/tmpfiles.d, which (being
# under /usr) is reapplied by systemd-tmpfiles on every boot regardless of
# whether this is a first install or an upgrade.
RUN groupadd -r greeter \
    && useradd -r -g greeter -d /var/lib/greeter -s /bin/bash -c "System Greeter" greeter \
    && install -m 0644 /usr/share/quickshell/dms/systemd/tmpfiles-dms-greeter.conf /usr/lib/tmpfiles.d/dms-greeter.conf \
    && install -m 0755 /usr/share/quickshell/dms/Modules/Greetd/assets/dms-greeter /usr/local/bin/dms-greeter

COPY <<-'EOF' /etc/greetd/config.toml
[terminal]
vt = 1

[default_session]
user = "greeter"
# --path dms: dms-greeter defaults to looking for its QML shell under a
# config named "dms-greeter" (.../quickshell/dms-greeter/shell.qml) — the
# convention upstream's own git-clone-based manual install uses. Fedora's
# DankMaterialShell RPM doesn't ship a copy under that name; it only
# installs the real shell at /usr/share/quickshell/dms/shell.qml. Without
# this flag, dms-greeter's locate_dms_config lookup fails and it exits
# immediately (greetd logs this as "greeter exited without creating a
# session"), so point it at the config Fedora actually installs instead.
command = "/usr/local/bin/dms-greeter --command niri --path dms"
EOF

RUN systemctl --global enable dms.service \
    && systemctl enable greetd.service

# 4. Boot straight to the greeter instead of `base`'s console default. Without
# this, the host stays on `multi-user.target` and greetd/niri-session/DMS
# never run at all — a user stuck at a bare tty who starts `niri` by hand
# bypasses greetd's session wiring entirely and gets vanilla niri with no
# DankMaterialShell, since dms.service (wanted by graphical-session.target)
# is only pulled in via the niri-session -> niri.service -> graphical-session
# .target chain that greetd's login triggers.
RUN systemctl set-default graphical.target
